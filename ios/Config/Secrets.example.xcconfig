// Copy this file to Secrets.xcconfig (git-ignored) and fill in the real values.
// CI uses these placeholders as they are: the UI tests run against the in-process scripted client.
//
// There is no access token in the app any more: each student types their own code once and it lives in the Keychain.
// (An APP_ACCESS_TOKEN line left in an older Secrets.xcconfig is ignored: nothing reads it.)
//
// In an .xcconfig file "//" starts a comment, so a URL is written as https:/$()/host
SERVER_URL = https:/$()/pencil-tutor.vercel.app

// The app's bundle id. It must be the same as the app record in App Store Connect and as APPLE_BUNDLE_ID on the server.
// Whoever owns the Apple Developer account sets this (docs/app-store.md); the default is the id used for development so far.
APP_BUNDLE_ID = com.edwardtran.penciltutor

// The in-app subscription's product id, exactly as created in App Store Connect and as APPLE_IAP_PRODUCT_ID on the server.
// ios/StoreKit/PencilTutor.storekit (local testing in Xcode) uses the same id; change both together.
IAP_PRODUCT_ID = penciltutor.monthly

// Privacy policy and terms of use pages, shown beside the Subscribe button when set (App Review expects both for a subscription).
// Leave empty until the pages exist. Write a URL as https:/$()/host/path because "//" starts a comment in this file.
PRIVACY_POLICY_URL =
TERMS_URL =

// Your Apple developer team id (10 characters). Needed only to install on a real iPad.
// Leave empty in this example file; put the real value in Secrets.xcconfig.
DEVELOPMENT_TEAM =
